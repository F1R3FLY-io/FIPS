@startuml
title Buffer factory, buffer agent, and File-agent integration
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ClassBorderColor #37474F
skinparam ClassBackgroundColor #DDF0DD
skinparam ClassAttributeFontColor #263238

class "BufferFactory\nrho:lang:buffer" as Factory #F4C99A {
  + alloc(nUnits, unit) : bundle+ handle
  + allocBytes(n) / allocUtf8(n)
  + allocRows(m, innerN, innerUnit)
  + default(...args)
}
class "Buffer agent" as Buffer {
  - meta @(this, metaP) = (ℓ, ρ, C, unit, lease, lo, hi) | REVOKED
  - append-only chunks @(this, chunkP, j), lo <= j < hi
  --
  + capacity() / length() / remaining() / unit()
  + isFull() / isEmpty()
  + writeByte(x) / writeBytes(xs)
  + read(n) / slice(o,n) / toByteArray()
  + validUtf8PrefixLen() / view()
  + beginFill() : fillToken
  + endFill(fillToken)
  + clear() / close()
  + default(...args)
}
class "Rows agent (buffer of buffers)" as Rows #E7DEF2 {
  + capacityRows() / innerUnit()
  + getAt(i) : inner buffer
  + clear() / close()
  + default(...args)
}
class "File agent" as File #D2ECEC {
  + readInto(buf) / readAtInto(offset, buf)
  + readLineInto(buf) / writeFrom(buf)
  + readLinesInto(rows)
}
Factory ..> Buffer : creates (returns bundle+)
Factory ..> Rows : allocRows creates
Rows *-- Buffer : m inner buffers
File ..> Buffer : fills via writeBytes\nunder a fill lease
@enduml
