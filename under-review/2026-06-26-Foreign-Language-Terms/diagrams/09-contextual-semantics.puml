@startuml
title Three Context Roles and Admissible Observation
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName SansSerif

rectangle "Scoped guest term\np" as P #DCFCE7
rectangle "FLT template hole\npositive fill / negative capture" as Template #FEF3C7
rectangle "Hypercube displayed site\nindex · rely · ambient" as Site #E0E7FF
rectangle "Observer context\nc in D_handle" as Observer #EDE9FE
rectangle "Observation-profile gate" as Gate #A7F3D0
rectangle "Behavioral observation" as Result #DCFCE7
rectangle "Raw AST reflection" as Reflect #FEE2E2

P --> Template : substitution role
P --> Site : operational-profile role
P --> Observer : contextual experiment
Observer --> Gate : requires Observe/Match
Gate --> Result : admissible whole context
Observer -[#DC2626,dashed]-> Reflect : requires separate ReflectAst

legend right
  |= Color |= Concept |
  |<#DCFCE7> | Guest term / behavioral result |
  |<#FEF3C7> | FLT template role |
  |<#E0E7FF> | Hypercube displayed-site role |
  |<#EDE9FE> | Observer-context role |
  |<#A7F3D0> | Admissibility and authority gate |
  |<#FEE2E2> | Raw reflection is not implied |
endlegend
@enduml
