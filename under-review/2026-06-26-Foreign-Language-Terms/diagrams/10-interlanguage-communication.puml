@startuml
title Interlanguage Communication over One Reflected ABI
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName SansSerif

rectangle "Language A term\n<latex>\llbracket t_A \rrbracket</latex> tagged <latex>\ulcorner \mathit{fp}_A \urcorner</latex>" as TA #DBEAFE
rectangle "Language B term\n<latex>\llbracket t_B \rrbracket</latex> tagged <latex>\ulcorner \mathit{fp}_B \urcorner</latex>" as TB #DCFCE7
rectangle "Host Rholang\nsends / receives / guards" as Host #FEF3C7

frame "One RSpace : reflected tagged-Par ABI" as ABI #F8FAFC {
  rectangle "Tag-identity dispatch\n<latex>\mathrm{pat\_tagged}(\mathit{fp}_A)</latex> matches only <latex>\mathit{fp}_A</latex> heads" as Match #FDE68A
  rectangle "Opaque graft at slot <latex>\pi</latex>\nforced when <latex>\mathit{fp}_B \neq \mathit{fp}_A</latex>" as Graft #E0F2FE
  rectangle "<latex>\mathit{fp}_A</latex> driver\ndrives A subterms" as DriveA #DBEAFE
  rectangle "<latex>\mathit{fp}_B</latex> driver\ndrives B subterms" as DriveB #DCFCE7
}

rectangle "Composite <latex>A[B]</latex>\nnormal-form set" as Comp #EDE9FE
rectangle "Foreign tag cannot forge a host pattern\nnon-firing, never mis-firing" as NoForge #FEE2E2
rectangle "[Proposed] R2 re-dispatch\ntoday: fail-closes (safe, stuck)" as R2 #FEE2E2

TA --> Match : reflect
TB --> Match : reflect
Host --> Match : host pattern
Match --> Graft : shapes agree (tag identity)
Match -[#DC2626,dashed]-> NoForge : <latex>\mathit{fp}_B</latex> head vs <latex>\mathit{fp}_A</latex> pattern
Graft --> DriveA : A subterms
Graft --> DriveB : opaque B child
DriveA --> Comp : A rewrites
DriveB --> Comp : B rewrites (R2)
DriveA -[#DC2626,dashed]-> R2 : foreign child today

legend right
  |= Color |= Concept |
  |<#DBEAFE> | Language A / host process |
  |<#DCFCE7> | Language B / guest term |
  |<#FEF3C7> | Host Rholang contract |
  |<#FDE68A> | Tag-identity matching |
  |<#E0F2FE> | Opaque interpolation graft |
  |<#EDE9FE> | Composite / shared substrate |
  |<#FEE2E2> | Rejected or [Proposed] stuck |
endlegend
@enduml
