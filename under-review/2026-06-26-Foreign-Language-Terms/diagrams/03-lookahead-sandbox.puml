@startuml
title Lookahead Over an FLT Send
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam sequence {
  ArrowColor #374151
  LifeLineBorderColor #6B7280
  LifeLineBackgroundColor #F9FAFB
  ParticipantBorderColor #374151
}

participant "Rholang send\nx!(FLT)[*]" as Send #DBEAFE
participant "Lookahead operator" as Lookahead #FEF3C7
collections "Sandboxed\nempty RSpaces" as Spaces #FCE7F3
database "success PathMap" as Success #DCFCE7
database "failure PathMap" as Failure #FEE2E2
queue "channel x" as X #FEF3C7
participant "receive\nfor (... <- x)" as Receive #DBEAFE

Send -> Lookahead : suffix belongs to the send
Lookahead -> Spaces : fork every rewrite trace
loop each possible trace
  Spaces -> Spaces : run FLT in a fresh empty RSpace
end
Spaces --> Success : insert successful leaf
Spaces --> Failure : insert abort trace and error
Success --> X : place PathMap name
Failure --> X : place PathMap name
X -> Receive : consume an offered name

legend right
  |= Color |= Concept |
  |<#DBEAFE> | Host process / receive |
  |<#FEF3C7> | Lookahead syntax / channel |
  |<#FCE7F3> | Speculative sandbox |
  |<#DCFCE7> | Success result |
  |<#FEE2E2> | Failure result |
endlegend
@enduml
