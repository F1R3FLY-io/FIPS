component "generated Rholang 1.4 frontend\n<latex>\mathsf{Cost}(\mathsf{Rho})</latex>" as generated #C7D2FE
component "fixed-point verifier\ncanonical bytes · fingerprints · ABIs" as fixed #A7F3D0
component "LanguageBundleV1\nreproducible production artifact" as bundle #FBCFE8
component "slim neutral frontend\nRho IR · occurrences · cost evidence" as frontend #DBEAFE
component "f1r3node adapter\nexact Par bytes · resource projection" as adapter #DDD6FE
component "one reducer + settlement engine\natomic effects · replay" as host #BFDBFE

component "application-defined language/3\nTheory G · OSLF judgments" as guest #E0E7FF
component "checked installed handle\nscoped rights · full fingerprint" as handle #FBCFE8
