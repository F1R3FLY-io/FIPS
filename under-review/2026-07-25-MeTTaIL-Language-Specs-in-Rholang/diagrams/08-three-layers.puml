skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName SansSerif
skinparam ArrowColor #334155

package "L0 — authoring surface  [Branch]" #FFFBEB {
  rectangle """Module M { Theory T(p: P) { … } theory T(A) }""" as DECL #FDE68A
  rectangle "<latex>\mathit{TheoryExpr}</latex>\njoin <latex>\backslash/</latex> · meet <latex>/\backslash</latex> · difference <latex>\backslash</latex>\napplication · ""let"" · ordered builders" as EE #FDE68A
}

package "L1 — presentation content" #EEF2FF {
  rectangle "**Canonical language/2 value** — //authoritative//\n""{ &#34;mettail&#34;: &#34;language/2&#34;, … }""\nmaps · lists · strings\nprogrammatically constructible" as VAL #E0E7FF
}

rectangle "**L2 — generalized seam**  [Branch]\n""GrammarCoreV1""\nstable IDs · no Rust source" as LD #DBEAFE

rectangle "backends\nparser · rho-native · Dovetail · emitters" as BE #F8FAFC

DECL --> EE : body
EE -[#7C3AED,dashed]-> VAL : ""parse_module"" + elaborate + normalize\n**surface/value parity**
VAL --> LD : fail-closed ""value_to_core""
LD --> BE

note bottom of VAL #ECFDF5
  **One authority.** The surface parser emits a value; it does not feed a second
  backend model. Directly constructed and surface-derived values run through the
  same decoder, validator, semantic fingerprint, and GrammarCore lowering.

  ""language!"" remains the typed compile-time path for existing grammars and
  projects into GrammarCore for conformance. It does not detour through the image VM.

  Only the value can be **sent on a channel**, **stored in the tuplespace**,
  **versioned in the registry**, **transformed by Rholang code**, and
  **matched with Rholang patterns** — which is why it, and not the text,
  is normative for identity and interchange.
end note

